{
  "name": "slop-shooter",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/",
    "balance": "vitest run tools/balance --disableConsoleIntercept",
    "weapons": "vitest run tools/weapons --disableConsoleIntercept",
    "progression": "vitest run tools/progression --disableConsoleIntercept",
    "soak": "vitest run tools/soak --disableConsoleIntercept"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
